VITE_CORE_API_URL=/core-api
VITE_CURRENCIES_API_URL=/currencies-api
VITE_INFO_API_URL=
VITE_ASSISTANT_API_URL=
VITE_AUTO_LOGIN=true
VITE_DEMO_EMAIL=igor@example.com
VITE_DEMO_PASSWORD=password123

# Production note:
# When frontend is served by nginx together with backend containers, keep these values relative.
# nginx.conf proxies /core-api to core-service:8080 and /currencies-api to currencies-service:8081.
VITE_APP_BASE_PATH=./
